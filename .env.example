# AquaAgent - Smart Water Conservation Assistant Configuration
PORT=3000

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
# You can also enter this directly in the web UI Settings modal!
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Simulation tick speed in milliseconds (default: 2000ms = 2s)
SIMULATION_TICK_MS=2000
